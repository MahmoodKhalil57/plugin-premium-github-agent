{
	"name": "premium-cms-plugin",
	"version": "0.1.0",
	"type": "module",
	"description": "A PremiumCMS plugin",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"bundle": "emdash-plugin bundle",
		"validate": "emdash-plugin validate .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@premium-cms/emdash": ">=0.35.0"
	},
	"devDependencies": {
		"@premium-cms/plugin-cli": "^0.8.1",
		"@premium-cms/plugin-types": "^0.3.0",
		"@premium-cms/emdash": "^0.35.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
