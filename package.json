{
	"name": "premium-cms-plugin-premium-github-agent",
	"version": "0.2.5",
	"type": "module",
	"description": "PremiumCMS GitHub Agent: issues on the connected repo + a Cloudflare-hosted coding agent that opens fix PRs",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"bundle": "emdash-plugin bundle",
		"validate": "emdash-plugin validate .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@premium-cms/emdash": ">=0.35.27"
	},
	"devDependencies": {
		"@premium-cms/plugin-cli": "^0.8.2",
		"@premium-cms/plugin-types": "^0.3.2",
		"@premium-cms/emdash": "^0.35.27",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
