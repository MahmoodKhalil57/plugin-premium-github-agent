{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "premium-cms-issue-agent",
	"main": "src/server.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [
			{ "class_name": "IssueFixer", "name": "IssueFixer" },
			{ "class_name": "Sandbox", "name": "Sandbox" }
		]
	},
	"migrations": [
		{ "new_sqlite_classes": ["IssueFixer"], "tag": "v1" },
		{ "new_sqlite_classes": ["Sandbox"], "tag": "v2" }
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "docker.io/cloudflare/sandbox:0.12.9",
			"instance_type": "basic",
			"max_instances": 3
		}
	],
	"observability": { "enabled": true }
}
