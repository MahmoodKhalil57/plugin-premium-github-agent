{
	"$schema": "./node_modules/@premium-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "premium-github-agent",
	"publisher": "plugins.premium-cms.com",
	"license": "MIT",
	"author": { "name": "PremiumCMS" },
	"security": {
		"url": "https://github.com/MahmoodKhalil57/plugin-premium-github-agent/security/advisories/new",
	},
	"description": "Read and file issues on the connected GitHub repo, and let a Cloudflare-hosted coding agent turn them into pull requests — one at a time, or as stacked layers merged bottom-up — only for whitelisted GitHub users.",
	"keywords": ["premiumcms", "github", "issues", "agent", "ai"],

	// The site's own GitHub connection (Settings → General) is the only
	// credential: issues are read and created with it, and it is handed to the
	// agent per run so the PR is opened as the site owner. The agent and the
	// builds run inside the instance (never GitHub Actions).
	// agents:run + sandbox:build: the instance's own Think agent and build
	// sandbox — the plugin's AI and compute never leave the instance.
	"capabilities": ["network:request", "github:connection", "agents:run", "sandbox:build"],
	"allowedHosts": ["api.github.com", "*.premium-cms.com"],
	"storage": {
		"runs": { "indexes": ["status", "updatedAt", "number"] },
		"builds": { "indexes": ["status", "updatedAt", "pr"] },
		"stacks": { "indexes": ["status", "updatedAt"] },
	},

	"admin": {
		"settingsSchema": {
			"enabled": {
				"type": "boolean",
				"label": "React to /commands",
				"description": "Off: issue and pull-request comments are recorded but nothing runs.",
				"default": true
			},
			"allowedUsers": {
				"type": "string",
				"label": "Whitelisted GitHub users",
				"description": "Comma-separated GitHub logins whose /commands, issues and pull requests the agent acts on."
			},
			"maxBuildAttempts": {
				"type": "number",
				"label": "Max build attempts per PR",
				"description": "How many fix → build → test rounds a pull request gets before the agent stops retrying.",
				"default": 3,
				"min": 1,
				"max": 10
			},
			"autoMerge": {
				"type": "boolean",
				"label": "Allow automatic merges",
				"description": "Merging is opted in per issue or pull request with /auto-agent-merge (a comment, the create-issue toggle, or the MCP). Off: nothing is ever merged automatically, opted in or not.",
				"default": true
			},
			"model": { "type": "string", "label": "Model", "description": "Workers AI model id handed to the agent.", "default": "@cf/zai-org/glm-5.3-flash" },
			"reasoning": {
				"type": "select",
				"label": "Reasoning effort",
				"options": [
					{ "value": "high", "label": "High (slow, thorough)" },
					{ "value": "medium", "label": "Medium" },
					{ "value": "low", "label": "Low" }
				],
				"default": "high"
			}
		},
		"pages": [{ "path": "/github-agent", "label": "GitHub Agent", "icon": "git-pull-request" }],
		"widgets": [
			{ "id": "deployments", "title": "Deployments", "size": "half" },
			{ "id": "agent-runs", "title": "GitHub Agent", "size": "half" },
		],
	},
}
